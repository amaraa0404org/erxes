{
  "name": "core-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/core-api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/core-api",
        "assets": ["apps/core-api/src/private/**/*"],
        "commands": ["pnpm build"]
      },
      "dependsOn": ["^build", "build:packageJson"]
    },

    "build:packageJson": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "apps/core-api/dist/src/main.js",
        "tsConfig": "apps/core-api/tsconfig.build.json",
        "outputPath": "apps/core-api/dist",
        "updateBuildableProjectDepsInPackageJson": true,
        "assets": ["apps/core-api/src/private/**/*"],

        "buildableProjectDepsInPackageJsonType": "dependencies"
      }
    },

    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["typecheck", "build"],
      "options": {
        "cwd": "apps/core-api",
        "command": "NODE_ENV=development && node dist/src/main.js"
      }
    },

    "serve": {
      "executor": "nx:run-commands",

      "options": {
        "cwd": "apps/core-api",
        "command": "NODE_ENV=development pnpm dev"
      }
    },

    "docker-build": {
      "dependsOn": ["build"],
      "command": "docker build -f apps/core-api/Dockerfile . -t erxes/erxes-next-core-api"
    }
  }
}
