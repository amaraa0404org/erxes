{
  "name": "erxes-api-shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/erxes-api-shared/src",
  "projectType": "library",
  "tags": [
    "scope:shared"
  ],
  "targets": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/utils/package.json",
        "{projectRoot}/utils/dist",
        "{projectRoot}/core-types/package.json",
        "{projectRoot}/core-types/dist",
        "{projectRoot}/core-modules/package.json",
        "{projectRoot}/core-modules/dist"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "packages/erxes-api-shared/jest.config.ts"
      }
    }
  }
}
